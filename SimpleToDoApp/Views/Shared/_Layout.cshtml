<!DOCTYPE html>
<html class="h-full bg-[#f8fafc]">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - SimpleToDo</title>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
        font-family: 'Quicksand', sans-serif;
        }
    </style>
</head>
<body class="h-full">
    <div class="min-h-full">
        <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-100">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="flex h-20 items-center justify-between">
                    <div class="flex items-center gap-8">
                        <div class="shrink-0 flex items-center gap-2">
                            <div class="bg-indigo-600 p-2 rounded-xl shadow-lg shadow-indigo-100">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                            </div>
                            <span class="text-xl font-bold text-slate-800 tracking-tight">SimpleToDo</span>
                        </div>
                        
                        <div class="hidden md:block">
                            <div class="flex items-baseline space-x-2">
                                <a asp-controller="Todos" asp-action="Index"
                                       class="px-4 py-2 rounded-xl text-sm font-semibold transition-all @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "bg-indigo-50 text-indigo-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
                                    Todos List
                                </a>
                                <a asp-controller="Todos" asp-action="AddNewTodos"
                                       class="px-4 py-2 rounded-xl text-sm font-semibold transition-all @(ViewContext.RouteData.Values["Action"]?.ToString() == "AddNewTodos" ? "bg-indigo-50 text-indigo-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
                                    Add More Todos
                                </a>
                                <a asp-action="Board"
                                       class="px-4 py-2 rounded-xl text-sm font-semibold transition-all @(ViewContext.RouteData.Values["Action"]?.ToString() == "Board" ? "bg-indigo-50 text-indigo-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
                                    Board
                                </a>
                                <a asp-action="Calendars" 
                                       class="px-4 py-2 rounded-xl text-sm font-semibold transition-all @(ViewContext.RouteData.Values["Action"]?.ToString() == "Calendars" ? "bg-indigo-50 text-indigo-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
                                       Xem lịch
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="hidden md:block">
                        <div class="ml-4 flex items-center gap-4">
                            @await Component.InvokeAsync("NotificationBell")

                            <div class="flex items-center gap-3 pl-4 border-l border-slate-100">
                                <div class="text-right hidden lg:block">
                                    <p class="text-sm font-bold text-slate-800">Thành Nam</p>
                                    <p class="text-xs text-slate-400">Developer</p>
                                </div>
                                <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"
                                     class="size-10 rounded-2xl border-2 border-white shadow-sm" alt="User" /> 
                                <a asp-controller="Accounts" asp-action="Logout"
                                   class="ml-2 p-2 text-slate-400 hover:text-rose-500 hover:bg-rose-50 rounded-xl transition-all"
                                   title="Đăng xuất">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main class="py-10">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                @RenderBody()
            </div>
        </main>
        
        <footer class="py-10 text-center text-slate-400 text-sm">
            <p>&copy; 2026 - Made by Nam</p>
        </footer>
    </div>
</body>
</html>