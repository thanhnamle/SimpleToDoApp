@model IEnumerable<SimpleToDoApp.Models.Todo>

<div class="relative group">
    <!-- Biểu tượng cái chuông -->
    <button class="p-2 text-slate-400 hover:text-indigo-600 transition-colors relative">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>

        @if (Model.Any())
        {
            <!-- Chấm đỏ báo hiệu có thông báo -->
            <span class="absolute top-1 right-1 flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
            </span>
        }
    </button>

    <!-- Dropdown danh sách thông báo (hiện khi hover hoặc click) -->
    <div class="absolute right-0 mt-2 w-80 bg-white rounded-3xl shadow-2xl border border-slate-100 hidden group-hover:block z-50 overflow-hidden">
        <div class="p-4 border-b border-slate-50 bg-slate-50/50">
            <h3 class="text-sm font-bold text-slate-800">Thông báo nhắc nhở</h3>
        </div>
        <div class="max-h-96 overflow-y-auto">
            @if (!Model.Any())
            {
                <div class="p-8 text-center">
                    <p class="text-slate-400 text-sm italic">Hiện không có nhắc nhở nào</p>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <a href="/Todos/DetailTodos/@item.Id" class="block p-4 hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0">
                        <p class="text-sm font-bold text-slate-800 line-clamp-1">@item.Title</p>
                        <p class="text-xs text-rose-500 font-semibold mt-1">Sắp diễn ra lúc: @item.StartDate.ToString("HH:mm")</p>
                    </a>
                }
            }
        </div>
    </div>
</div>
