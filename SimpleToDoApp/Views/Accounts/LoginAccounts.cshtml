@model SimpleToDoApp.Models.Login
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; // Để trang login có giao diện riêng biệt hoàn toàn
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Quicksand', sans-serif;
        }

        .glass {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        }
    </style>

    <!-- Nhúng thư viện SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["RegisterSuccess"] != null)
    {
        <script>
            Swal.fire({
            title: 'Thành công rồi! 🎉',
            text: '@TempData["RegisterSuccess"]',
            icon: 'success',
            confirmButtonText: 'Tuyệt vời',
            confirmButtonColor: '#4f46e5', // Màu Indigo đồng bộ với giao diện
            background: '#ffffff',
            borderRadius: '2rem',
            customClass: {
            popup: 'rounded-[2.5rem] p-10',
            title: 'text-2xl font-extrabold text-slate-800',
            confirmButton: 'px-8 py-3 rounded-2xl font-bold'
            }
            });
        </script>
    }

</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen p-6 overflow-hidden relative">

    <!-- Background Decor -->
    <div class="absolute top-0 left-0 w-96 h-96 bg-indigo-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-rose-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>

    <div class="glass w-full max-w-lg p-12 rounded-[3.5rem] shadow-2xl shadow-indigo-100/50 z-10 border-2 border-white">
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-indigo-600 rounded-3xl mx-auto mb-6 flex items-center justify-center shadow-xl shadow-indigo-200 rotate-12">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight">Chào mừng trở lại!</h1>
            <p class="text-slate-400 mt-3 font-medium">Đăng nhập để tiếp tục quản lý công việc của bạn.</p>
        </div>

        <form asp-action="Login" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-rose-500 text-sm font-bold bg-rose-50 p-4 rounded-2xl mb-4 text-center"></div>

            <div>
                <label asp-for="UsernameOrEmail" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-2">Tên đăng nhập hoặc Email</label>
                <div class="relative">
                    <input asp-for="UsernameOrEmail" placeholder="Nhập username hoặc emails của bạn..." class="w-full pl-14 pr-8 py-5 bg-slate-100/50 border-2 border-transparent rounded-[2rem] focus:ring-4 focus:ring-indigo-100 focus:bg-white focus:border-indigo-100 transition-all outline-none text-slate-800 font-bold" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 absolute left-5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-2">Mật khẩu</label>
                <div class="relative">
                    <input asp-for="Password" type="password" placeholder="••••••••" class="w-full pl-14 pr-8 py-5 bg-slate-100/50 border-2 border-transparent rounded-[2rem] focus:ring-4 focus:ring-indigo-100 focus:bg-white focus:border-indigo-100 transition-all outline-none text-slate-800 font-bold" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 absolute left-5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
            </div>

            <button type="submit" class="w-full py-6 bg-indigo-600 text-white rounded-[2rem] font-extrabold text-xl hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-100 active:scale-95 mt-4">
                Đăng nhập ngay
            </button>
        </form>

        <div class="mt-10 text-center">
            <p class="text-slate-400 font-medium">
                Chưa có tài khoản?
                <a asp-action="Register" class="text-indigo-600 font-extrabold hover:underline underline-offset-4 ml-1">Đăng ký thành viên</a>
            </p>
        </div>
    </div>
</body>
</html>
