@model SimpleToDoApp.Models.Register
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Quicksand', sans-serif;
        }</style>
    </head>
    <body class="bg-slate-50 flex items-center justify-center min-h-screen p-6 relative overflow-hidden">

        <!-- Trang trí -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-indigo-100 rounded-full blur-3xl opacity-50"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-rose-100 rounded-full blur-3xl opacity-50"></div>

        <div class="bg-white w-full max-w-xl p-12 rounded-[3.5rem] shadow-2xl shadow-indigo-100/50 z-10 border-2 border-white">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight">Gia nhập cộng đồng 🚀</h1>
                <p class="text-slate-400 mt-2 font-medium text-sm">Chỉ mất 30 giây để bắt đầu quản lý cuộc sống tốt hơn.</p>
            </div>

            <form asp-action="Register" method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div>
                    <label asp-for="Username" class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-2 ml-2">Tên đăng nhập</label>
                    <input asp-for="Username" placeholder="Ví dụ: nva_pro" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-4 focus:ring-indigo-100 focus:bg-white transition-all outline-none font-bold text-slate-700" />
                    <span asp-validation-for="Username" class="text-rose-500 text-[10px] mt-1 ml-2"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-2 ml-2">Địa chỉ Email</label>
                    <input asp-for="Email" type="email" placeholder="nva@example.com" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-4 focus:ring-indigo-100 focus:bg-white transition-all outline-none font-bold text-slate-700" />
                    <span asp-validation-for="Email" class="text-rose-500 text-[10px] mt-1 ml-2"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Password -->
                    <div>
                        <label asp-for="Password" class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-2 ml-2">Mật khẩu</label>
                        <input asp-for="Password" type="password" placeholder="••••••" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-4 focus:ring-indigo-100 focus:bg-white transition-all outline-none font-bold text-slate-700" />
                        <span asp-validation-for="Password" class="text-rose-500 text-[10px] mt-1 ml-2"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label asp-for="ConfirmPassword" class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-2 ml-2">Xác nhận lại</label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="••••••" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-4 focus:ring-indigo-100 focus:bg-white transition-all outline-none font-bold text-slate-700" />
                        <span asp-validation-for="ConfirmPassword" class="text-rose-500 text-[10px] mt-1 ml-2"></span>
                    </div>
                </div>

                <button type="submit" class="w-full py-5 bg-indigo-600 text-white rounded-[2rem] font-extrabold text-lg hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-100 active:scale-95 mt-4">
                    Đăng ký tài khoản
                </button>
            </form>

            <div class="mt-8 text-center">
                <p class="text-slate-400 font-medium text-sm">
                    Đã có tài khoản?
                    <a asp-action="Login" class="text-indigo-600 font-extrabold hover:underline underline-offset-8 ml-1 transition-all">Quay lại Đăng nhập</a>
                </p>
            </div>
        </div>
    </body>
</html>
