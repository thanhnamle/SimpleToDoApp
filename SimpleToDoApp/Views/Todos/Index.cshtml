@model IEnumerable<SimpleToDoApp.Models.Todo>
@{
    ViewData["Title"] = "Dashboard";
    var pendingCount = Model.Count(t => !t.IsCompleted);
}

<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">

<div class="container mx-auto px-6 py-10 max-w-7xl" style="font-family: 'Quicksand', sans-serif;">

    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-16 gap-8 bg-white/40 p-10 rounded-[3rem] backdrop-blur-md border border-white/60 shadow-sm">
        <div class="space-y-2">
            <h1 class="text-5xl font-black text-slate-900 tracking-tight">Chào bạn</h1>
            <p class="text-slate-500 text-lg">
                Hôm nay bạn có <span class="px-3 py-1 bg-indigo-50 text-indigo-600 rounded-full font-bold shadow-sm shadow-indigo-100/50">@pendingCount việc</span> cần ưu tiên nè.
            </p>
        </div>

        <div class="flex items-center gap-4 w-full lg:w-auto">
            <a asp-action="Calendars" class="flex-1 lg:flex-none flex items-center justify-center p-5 bg-white border border-slate-100 rounded-[2rem] text-slate-400 hover:text-indigo-600 hover:border-indigo-100 hover:shadow-xl hover:shadow-indigo-50 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </a>
            <a asp-action="AddNewTodos" class="flex-[2] lg:flex-none flex items-center justify-center px-10 py-5 bg-slate-900 text-white rounded-[2rem] font-bold shadow-2xl shadow-slate-200 hover:bg-indigo-600 hover:-translate-y-1 active:scale-95 transition-all duration-500 gap-3">
                <span class="text-2xl font-light">+</span> Viết task mới
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var item in Model.OrderByDescending(t => t.CreatedAt))
        {
            <div class="group relative bg-white/80 p-8 rounded-[3.5rem] border border-slate-100 shadow-sm hover:shadow-2xl hover:shadow-indigo-100/40 hover:-translate-y-2 transition-all duration-500 overflow-hidden">

                @* Status Indicator Line *@
                <div class="absolute top-0 left-0 w-full h-2 @(item.IsCompleted ? "bg-emerald-400" : (item.Priority == "Cao" ? "bg-rose-400" : "bg-indigo-400")) opacity-20"></div>

                @if (item.IsCompleted)
                {
                    <div class="absolute top-6 right-6 bg-emerald-500 text-white p-2 rounded-2xl shadow-lg rotate-12">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" /></svg>
                    </div>
                }

                <div class="flex items-center gap-3 mb-8">
                    <span class="px-4 py-1 bg-slate-50 text-slate-400 rounded-full text-[10px] font-black uppercase tracking-widest border border-slate-100">@item.Category</span>
                    @if (item.Priority == "Cao")
                    {
                        <span class="flex h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
                    }
                </div>

                <a asp-action="DetailTodos" asp-route-id="@item.Id" class="block group/link">
                    <h3 class="text-2xl font-extrabold @(item.IsCompleted ? "text-slate-300 line-through" : "text-slate-800 group-hover/link:text-indigo-600") transition-colors duration-300 leading-tight">
                        @item.Title
                    </h3>
                    <p class="text-slate-400 mt-4 text-sm line-clamp-2 leading-relaxed italic">
                        @(string.IsNullOrEmpty(item.Description) ? "Không có mô tả cho nhiệm vụ này..." : item.Description)
                    </p>
                </a>

                <div class="mt-10 pt-8 border-t border-slate-50/80 flex justify-between items-end">
                    <div class="space-y-3">
                        <div class="flex flex-col">
                            <span class="text-[10px] font-black text-slate-300 uppercase tracking-tighter mb-1">Bắt đầu</span>
                            <span class="text-xs font-bold text-slate-500 bg-slate-50 px-3 py-1 rounded-lg italic">@item.StartDate.ToString("dd/MM HH:mm")</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-black text-slate-300 uppercase tracking-tighter mb-1">Hạn chót</span>
                            <span class="text-xs font-bold @(item.DueDate < DateTime.Now && !item.IsCompleted ? "text-rose-500 bg-rose-50" : "text-slate-500 bg-slate-50") px-3 py-1 rounded-lg">@item.DueDate.ToString("dd/MM HH:mm")</span>
                        </div>
                    </div>

                    @* Quick Actions: Hiện lên khi hover card *@
                    <div class="flex flex-col gap-2 opacity-0 translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                        <a asp-action="EditTodos" asp-route-id="@item.Id" class="p-3 bg-indigo-50 text-indigo-500 rounded-2xl hover:bg-indigo-600 hover:text-white transition-all shadow-sm">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                        </a>
                        <a asp-action="DeleteTodos" asp-route-id="@item.Id" class="p-3 bg-rose-50 text-rose-500 rounded-2xl hover:bg-rose-600 hover:text-white transition-all shadow-sm">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Chống giật Masonry khi hover */
    .grid {
        align-items: start;
    }

    /* Hiệu ứng mượt cho các thẻ card */
    .group:hover {
        background-color: rgba(255, 255, 255, 1);
    }
</style>