@model IEnumerable<SimpleToDoApp.Models.Todo>
@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Bảng công việc";
}

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<div class="container mx-auto px-4 py-12 max-w-[1400px]" style="font-family: 'Quicksand', sans-serif;">
    <div class="mb-10 flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight">Project Board</h1>
            <p class="text-slate-500 mt-2 font-medium">Kéo thả để cập nhật trạng thái công việc.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
        <!-- Cột To Do -->
        @await Html.PartialAsync("_BoardColumn", new
        {
            Id = "To Do",
            Header = "📝 CHỜ LÀM",
            Tasks = Model.Where(t => t.Status == "To Do"),
            Color = "bg-slate-100"
        })

        <!-- Cột Doing -->
        @await Html.PartialAsync("_BoardColumn", new
        {
            Id = "Doing",
            Header = "⏳ ĐANG LÀM",
            Tasks = Model.Where(t => t.Status == "Doing"),
            Color = "bg-indigo-50"
        })

        <!-- Cột Done -->
        @await Html.PartialAsync("_BoardColumn", new
        {
            Id = "Done",
            Header = "✅ HOÀN THÀNH",
            Tasks = Model.Where(t => t.Status == "Done"),
            Color = "bg-emerald-50"
        })
    </div>
</div>

<script>
    fetch(`/Todos/UpdateStatus?id=${todoId}&status=${newStatus}`, {
        method: 'POST',
        headers: {
            // Đưa nó vào đây mới đúng cú pháp
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        }
    })

    
    document.addEventListener('DOMContentLoaded', function () {
    const columns = ['To Do', 'Doing', 'Done'];

    // Hàm đếm lại số lượng task trong mỗi cột
    function updateCounts() {
        columns.forEach(status => {
            const id = 'list-' + status.replace(' ', '-');
            const column = document.getElementById(id);
            if (column) {
                const count = column.children.length;
                // Tìm cái badge tròn tròn chứa con số để cập nhật
                const badge = column.parentElement.querySelector('span.bg-white');
                if (badge) badge.innerText = count;
            }
        });
    }

    columns.forEach(status => {
        const id = 'list-' + status.replace(' ', '-');
        const el = document.getElementById(id);

        new Sortable(el, {
            group: 'shared',
            animation: 150,
            ghostClass: 'sortable-ghost',
            forceFallback: true,
            fallbackOnBody: true, // Giúp thẻ không bị kẹt khi kéo

            onEnd: function (evt) {
                const todoId = evt.item.getAttribute('data-id');
                const newStatus = evt.to.getAttribute('data-status');

                // 1. Cập nhật con số hiển thị ngay lập tức
                updateCounts();

                // 2. Gửi lệnh lưu vào Database
                fetch(`/Todos/UpdateStatus?id=${todoId}&status=${newStatus}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                }).then(response => {
                    if (!response.ok) {
                        alert("Lỗi khi lưu trạng thái!");
                        location.reload(); // Nếu lỗi thì reload để quay về trạng thái cũ
                    }
                });
            }
        });
    });
    });
</script>

