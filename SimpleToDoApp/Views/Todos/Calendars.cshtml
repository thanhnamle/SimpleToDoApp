@{
    ViewData["Title"] = "Lịch công việc";
}

<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
<!-- FullCalendar CSS -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>

<div class="container mx-auto px-6 py-12 max-w-6xl" style="font-family: 'Quicksand', sans-serif;">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-bold text-slate-800">Lịch trình của bạn</h1>
            <p class="text-slate-500 mt-2">Quản lý thời gian một cách trực quan nhất.</p>
        </div>
        <a asp-action="Index" class="px-6 py-3 bg-white border-2 border-slate-100 text-slate-600 rounded-2xl hover:bg-slate-50 transition-all font-semibold shadow-sm">
            Dạng danh sách
        </a>
    </div>

    <div class="bg-white p-8 rounded-[3rem] border-2 border-slate-100 shadow-xl shadow-slate-100/50">
        <div id='calendar'></div>
    </div>
</div>

<style>
    .fc {
    --fc-border-color: #f1f5f9;
    --fc-button-bg-color: #4f46e5;
    --fc-button-border-color: #4f46e5;
    --fc-button-hover-bg-color: #4338ca;
    }

    .fc .fc-toolbar-title {
    font-weight: 700;
    color: #1e293b;
    font-size: 1.5rem;
    }

    .fc .fc-button {
    border-radius: 12px;
    font-weight: 600;
    text-transform: capitalize;
    padding: 8px 16px;
    }

    .fc .fc-daygrid-day-number {
    font-weight: 600;
    color: #64748b;
    padding: 10px;
    }

    .fc-event {
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    border: none !important;
    transition: transform 0.2s;
    }

    .fc-event:hover {
    transform: scale(1.02);
    }

    .fc-theme-standard td, .fc-theme-standard th {
    border: 1px solid #f8fafc;
    }

    .fc-v-event {
    background-color: #4f46e5 !important;
    border: none !important;
    border-radius: 12px !important;
    padding: 4px !important;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1) !important;
    }

    .fc-v-event .fc-event-main {
    color: white !important;
    padding: 4px !important;
    }

    .fc-v-event .fc-event-title {
    font-weight: 700 !important;
    font-size: 0.8rem !important;
    }

    .fc-v-event .fc-event-time {
    font-size: 0.7rem !important;
    opacity: 0.9 !important;
    margin-bottom: 2px !important;
    }

    .fc-day-today {
    background-color: #fefce8 !important;
    }

    .fc-timegrid-slot-minor {
    border-top-style: none !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
    locale: 'vi',
    initialView: 'timeGridWeek',
    slotEventOverlap: false,
    eventMinHeight: 40,
    expandRows: true,

    headerToolbar: {
    left: 'prev,next today',
    center: 'title',
    right: 'dayGridMonth,timeGridWeek,timeGridDay'
    },
    buttonText: { today: 'Hôm nay', month: 'Tháng', week: 'Tuần', day: 'Ngày' },
    events: '/Todos/GetCalendar',

    eventClick: function(info) {
    window.location.href = '/Todos/DetailTodos/' + info.event.id;
    },

    eventTimeFormat: {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
    },

    slotLabelFormat: {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
    },

    handleWindowResize: true,
    stickyHeaderDates: true,
    allDayText: 'Cả ngày'
    });
    calendar.render();
    });
</script>