@model SimpleToDoApp.Models.Todo

@{
    ViewData["Title"] = "Chỉnh sửa công việc";
}

<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">

<div class="container mx-auto px-4 py-12 max-w-6xl" style="font-family: 'Quicksand', sans-serif;">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-10">
        <a asp-action="Index" class="p-4 bg-white border-2 border-slate-100 text-slate-400 rounded-3xl hover:text-indigo-600 hover:border-indigo-100 transition-all shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <div>
            <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight">Cập nhật công việc</h1>
            <p class="text-slate-400 text-sm font-bold uppercase tracking-widest mt-1">Mã công việc: #@Model.Id</p>
        </div>
    </div>

    <form asp-action="EditTodos" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="UserId" />

        <!-- CỘT TRÁI: THÔNG TIN CHI TIẾT -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Phần nội dung -->
            <div class="bg-white p-10 rounded-[3rem] border-2 border-slate-50 shadow-xl shadow-slate-100/50 space-y-8">
                <div>
                    <label asp-for="Title" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Tiêu đề</label>
                    <input asp-for="Title" class="w-full px-8 py-5 bg-slate-50 border-none rounded-[2rem] focus:ring-4 focus:ring-indigo-100 focus:bg-white transition-all outline-none text-slate-800 font-bold text-xl" />
                    <span asp-validation-for="Title" class="text-rose-500 text-xs mt-2 ml-1"></span>
                </div>

                <div>
                    <label asp-for="Description" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Mô tả công việc</label>
                    <textarea asp-for="Description" rows="6" class="w-full px-8 py-5 bg-slate-50 border-none rounded-[2rem] focus:ring-4 focus:ring-indigo-100 focus:bg-white transition-all outline-none text-slate-800 resize-none leading-relaxed"></textarea>
                </div>
            </div>

            <!-- Phần thời gian -->
            <div class="bg-white p-10 rounded-[3rem] border-2 border-slate-50 shadow-xl shadow-slate-100/50">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-2 h-8 bg-indigo-600 rounded-full"></div>
                    <h3 class="font-extrabold text-slate-800 uppercase tracking-widest text-sm">Thời gian thực hiện</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <label asp-for="StartDate" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Bắt đầu</label>
                        <input asp-for="StartDate" type="datetime-local" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" class="w-full px-8 py-5 bg-slate-50 border-none rounded-[2rem] focus:ring-4 focus:ring-indigo-100 focus:bg-white transition-all outline-none text-slate-800 font-bold" />
                    </div>
                    <div>
                        <label asp-for="DueDate" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Kết thúc</label>
                        <input asp-for="DueDate" type="datetime-local" value="@Model.DueDate.ToString("yyyy-MM-ddTHH:mm")" class="w-full px-8 py-5 bg-slate-50 border-none rounded-[2rem] focus:ring-4 focus:ring-rose-100 focus:bg-white transition-all outline-none text-slate-800 font-bold" />
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: PHÂN LOẠI & TRẠNG THÁI -->
        <div class="space-y-8">
            <div class="bg-white p-10 rounded-[3rem] border-2 border-slate-50 shadow-xl shadow-slate-100/50 space-y-8">

                <!-- TOGGLE HOÀN THÀNH -->
                <div class="flex items-center p-6 bg-emerald-50 rounded-[2rem] border-2 border-emerald-100 group cursor-pointer transition-all hover:bg-emerald-100">
                    <input asp-for="IsCompleted" type="checkbox" id="mainIsCompleted" class="w-8 h-8 rounded-xl text-emerald-600 border-emerald-300 focus:ring-emerald-400 cursor-pointer" />
                    <label for="mainIsCompleted" class="ml-4 block text-lg font-extrabold text-emerald-800 cursor-pointer select-none">Xong rồi! ✅</label>
                </div>

                <!-- TOGGLE CẢ NGÀY -->
                <div class="flex items-center p-6 bg-indigo-50 rounded-[2rem] border-2 border-indigo-100 group cursor-pointer transition-all hover:bg-indigo-100">
                    <input asp-for="IsAllDay" type="checkbox" id="isAllDay" class="w-8 h-8 rounded-xl text-indigo-600 border-indigo-300 focus:ring-indigo-400 cursor-pointer" />
                    <label for="isAllDay" class="ml-4 block text-lg font-extrabold text-indigo-800 cursor-pointer select-none">Cả ngày 📅</label>
                </div>

                <hr class="border-slate-50" />

                <!-- Status & Category -->
                <div class="space-y-6">
                    <div>
                        <label asp-for="Status" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Trạng thái</label>
                        <select asp-for="Status" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-indigo-400 outline-none font-bold text-slate-700">
                            <option value="To Do">📝 Chờ làm</option>
                            <option value="Doing">⏳ Đang làm</option>
                            <option value="Done">✅ Đã xong</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="Category" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Phân loại</label>
                        <select asp-for="Category" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-indigo-400 outline-none font-bold text-slate-700">
                            <option value="🏢 Công việc">🏢 Công việc</option>
                            <option value="🏠 Cá nhân">🏠 Cá nhân</option>
                            <option value="📚 Học tập">📚 Học tập</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Độ ưu tiên</label>
                        <div class="flex gap-2">
                            @foreach (var p in new[] { "Thấp", "Trung bình", "Cao" })
                            {
                                <label class="flex-1 cursor-pointer">
                                    <input type="radio" asp-for="Priority" value="@p" class="peer hidden" />
                                    <div class="py-3 text-center rounded-xl bg-slate-50 text-[10px] font-bold text-slate-400 border-2 border-transparent peer-checked:border-indigo-400 peer-checked:bg-indigo-50 peer-checked:text-indigo-600 transition-all uppercase">@p</div>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <label asp-for="ReminderMinutes" class="block text-xs font-extrabold text-slate-400 uppercase tracking-widest mb-3 ml-1">Nhắc nhở trước</label>
                        <select asp-for="ReminderMinutes" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-indigo-400 outline-none font-bold text-slate-700">
                            <option value="0">Không nhắc</option>
                            <option value="5">5 phút</option>
                            <option value="15">15 phút</option>
                            <option value="60">1 giờ</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="space-y-4">
                <button type="submit" class="w-full py-6 bg-indigo-600 text-white rounded-[2rem] font-extrabold text-xl hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-100 active:scale-95">Lưu thay đổi</button>
                <a asp-action="DeleteTodos" asp-route-id="@Model.Id" class="block w-full py-4 text-center text-rose-500 font-bold hover:text-rose-700 transition-all text-sm uppercase tracking-widest">Xóa công việc này</a>
            </div>
        </div>
    </form>
</div>

<!-- JS Xử lý IsAllDay -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const checkbox = document.getElementById('isAllDay');
        const startInput = document.querySelector('input[name="StartDate"]');
        const endInput = document.querySelector('input[name="DueDate"]');

        function toggleInputs() {
            if (checkbox.checked) {
                startInput.readOnly = true;
                endInput.readOnly = true;
                startInput.style.opacity = "0.5";
                endInput.style.opacity = "0.5";
            } else {
                startInput.readOnly = false;
                endInput.readOnly = false;
                startInput.style.opacity = "1";
                endInput.style.opacity = "1";
            }
        }

        checkbox.addEventListener('change', toggleInputs);
        toggleInputs();
    });
</script>
